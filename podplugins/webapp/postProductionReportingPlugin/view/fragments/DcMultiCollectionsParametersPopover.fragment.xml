<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout">
<Popover id="dcMultiCollectionsParametersPopover" showHeader="false" afterClose="onDcMultiCollectionsPopoverAfterClose" contentWidth="480px" contentHeight="360px" contentMinWidth="360px" resizable="true" placement="Left">
<NavContainer id="multiCollectionsPopoverNavContainer">
<Page id="collectionsPage" title="{i18n>dcMultiCollectionsPopover.collectionsPage.title}">
<Table id="dcCollectionsTable" itemPress="onNavToParametersPress" backgroundDesign="Solid" growing="true" growingThreshold="50" growingScrollToLoad="true" items="{ path: 'dcParametersPopoverModel>/multiCollectionsParameters', sorter: { path: 'sfc', group: true } }">
<columns>
<Column vAlign="Middle">
<Text text="{i18n>dcMultiCollectionsPopover.collectionsList.collectionNameDateCreated.col}" wrapping="false"/>
</Column>
</columns>
<items>
<ColumnListItem type="Navigation">
<cells>
<ObjectIdentifier title="{dcParametersPopoverModel>collectionName}" text="{parts:[{path: 'dcParametersPopoverModel>createdDate'}], formatter: '.formatter.dmcDateTimeFormatterFromUTC'}"/>
</cells>
</ColumnListItem>
</items>
</Table>
</Page>
<Page id="parametersPage" title="{i18n>DCParameterPopupTitle}" showNavButton="true" navButtonPress="onNavBackToCollectionsPress">
<subHeader>
<OverflowToolbar>
<Label text="{dcParametersPopoverModel>sfc} / {dcParametersPopoverModel>collectionName} / {parts:[{path: 'dcParametersPopoverModel>createdDate'}], formatter: '.formatter.dmcDateTimeFormatterFromUTC'}" design="Bold"/>
</OverflowToolbar>
</subHeader>
<Table id="dcParametersTable" width="100%" backgroundDesign="Solid" mode="None" items="{dcParametersPopoverModel>parameters}">
<columns>
<Column width="50%">
<Text text="{i18n>DCParameter_NameType.LABEL}" wrapping="false"/>
</Column>
<Column hAlign="End">
<Text text="{i18n>DCParameter_ValueUnit.LABEL}" wrapping="false"/>
</Column>
</columns>
<items>
<ColumnListItem>
<cells>
<ObjectIdentifier title="{dcParametersPopoverModel>measureName}" text="{dcParametersPopoverModel>measureType}"/>
<l:VerticalLayout>
<ObjectNumber number="{dcParametersPopoverModel>actual}" unit="{${dcParametersPopoverModel>commercialUnitOfMeasure} ? ${dcParametersPopoverModel>commercialUnitOfMeasure} : ${dcParametersPopoverModel>unitOfMeasure}}"/>
<Label text="{=${ParametersData>disabledParameter} ? ${i18n>DCParameterDisabled.LABEL} : ${ParametersData>optionalParameter} ? ${i18n>dcParameter.optional.lbl} : ''}" class="sapUiTinyMarginTop"/>
</l:VerticalLayout>
</cells>
</ColumnListItem>
</items>
</Table>
</Page>
</NavContainer>
</Popover>
</core:FragmentDefinition>
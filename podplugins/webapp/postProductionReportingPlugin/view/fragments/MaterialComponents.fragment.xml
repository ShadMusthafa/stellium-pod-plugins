<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout">
    <Table autoPopinMode="true" contextualWidth="Auto" id="materialComponentsTable" class="sapUiNoMarginTop"
        items="{matConsModel>/lineItems}">
        <headerToolbar>
            <OverflowToolbar>
                <content>
                    <Title text="{i18n>materialComponents.header}" />
                    <ToolbarSpacer />
                    <Button id="saveBtnMatCons" press=".MaterialComponents.onSaveBtnPress" text="{i18n>saveData.btn}"
                        enabled="false" type="Emphasized" />
                    <Button id="clearBtnMatCons" press=".MaterialComponents.onClearBtnPress"
                        text="{i18n>clearData.btn}" />
                    <ToolbarSeparator />
                    <Button id="addNBCMatCons" text="{i18n>addNBC.btn}"
                        press=".MaterialComponents.onAddNonBomMaterial"
                        visible="false" />
                </content>
            </OverflowToolbar>
        </headerToolbar>
        <columns>
            <Column mergeDuplicates="true" mergeFunctionName="data#mergeKey">
                <Label text="{i18n>process.material.col}" />
            </Column>
            <Column hAlign="End">
                <Label text="{i18n>process.threshold.col}" />
            </Column>
            <Column hAlign="End">
                <Label text="{i18n>process.postedValue.col}" />
            </Column>
            <Column hAlign="Center">
                <Label text="{i18n>process.action.col}" />
            </Column>
            <Column hAlign="Begin" demandPopin="true">
                <Label text="{i18n>process.batchId.col}" />
            </Column>
            <Column hAlign="Begin" demandPopin="true">
                <Label text="{i18n>process.storLoc.col}" wrapping="true" />
            </Column>
            <Column hAlign="Begin" demandPopin="true">
                <Label text="{i18n>process.quantity.col}" />
            </Column>
            <Column demandPopin="true">
                <Label text="{i18n>process.unit.col}" />
            </Column>
            <Column demandPopin="true">
                <Label text="{i18n>process.postingDateTime.col}" wrapping="true" />
            </Column>
            <Column demandPopin="true">
                <Label text="{i18n>process.postedBy.col}" />
            </Column>
            <Column demandPopin="true" visible="{=${configuration>/customField1} ? true : false}">
                <Label text="{configuration>/customField1}" />
            </Column>
            <Column hAlign="Center" width="5%"> </Column>
        </columns>
        <items>
            <ColumnListItem highlight="{matConsModel>rowStatus}">
                <VBox>
                    <Text text="{matConsModel>materialId/material}" class="boldText" />
                    <Text text="{matConsModel>description}" />
                    <Label class="sapDmeItalicText"
                        text="{=${matConsModel>backflushEnabled} ? '('+${i18n>backflush}+')':''}"
                        visible="{matConsModel>backflushEnabled}" />
                    <customData>
                        <core:CustomData key="mergeKey"
                            value="{parts : [ 'matConsModel>materialId/material', 'matConsModel>description', 'matConsModel>backflushEnabled', 'i18n>backflush' ], formatter: '.formatter.getMergeKey'}" />
                    </customData>
                </VBox>
                <Label visible="{matConsModel>actionBtnVisible}"
                    text="{parts : ['matConsModel>upperThresholdValue','matConsModel>lowerThresholdValue', 'matConsModel>consumedQtyEntryUom', 'matConsModel>consumedQuantity'],formatter:'.formatter.getThresholdValues'}"
                    wrapping="true" />
                <ProgressIndicator
                    tooltip="{parts : [ 'matConsModel>totalQtyEntryUom','matConsModel>totalQtyBaseUom','matConsModel>targetQuantity', 'matConsModel>consumedQtyEntryUom', 'matConsModel>consumedQuantity' ], formatter: '.formatter.getDisplayValueForMatCons'}"
                    percentValue="{parts : [ 'matConsModel>totalQtyEntryUom','matConsModel>totalQtyBaseUom','matConsModel>targetQuantity', 'matConsModel>consumedQtyEntryUom', 'matConsModel>consumedQuantity' ], formatter: '.formatter.getPercentValueForMatCons'}"
                    displayValue="{parts : [ 'matConsModel>totalQtyEntryUom','matConsModel>totalQtyBaseUom','matConsModel>targetQuantity', 'matConsModel>consumedQtyEntryUom', 'matConsModel>consumedQuantity' ], formatter: '.formatter.getDisplayValueForMatCons'}"
                    showValue="true"
                    state="{parts : [ 'matConsModel>totalQtyEntryUom','matConsModel>totalQtyBaseUom','matConsModel>targetQuantity', 'matConsModel>consumedQtyEntryUom', 'matConsModel>consumedQuantity', 'matConsModel>lowerThresholdValue'], formatter: '.formatter.getMatPostedQtyColorCode'}"
                    visible="{matConsModel>actionBtnVisible}" />
                <Button hAlign="Center" visible="{matConsModel>actionBtnVisible}"
                    press=".MaterialComponents.onViewPostsBtnPress" text="{i18n>process.viewPosts.btn}" width="100%"
                    tooltip="{i18n>process.viewPosts.btn}" />
                <Input value="{matConsModel>enteredBatchNumber}" showValueHelp="true"
                    valueHelpRequest=".MaterialComponents.showBatchDialog"
                    enabled="{parts : [ 'matConsModel>backflushEnabled', 'matConsModel>batchManaged', 'matConsModel>materialType', 'matConsModel>enteredStorageLoc', 'invManagedModel>/isInventoryManaged'], formatter: '.formatter.getDisplayBatchID'}"
                    change=".MaterialComponents.onBatchChange" />
                <Input value="{matConsModel>enteredStorageLoc}" showValueHelp="true" valueHelpOnly="true"
                    valueHelpRequest=".MaterialComponents.showStorageLocDialog"
                    enabled="{parts : [ 'matConsModel>backflushEnabled', 'matConsModel>batchManaged','matConsModel>materialType', 'invManagedModel>/isInventoryManaged'], formatter: '.formatter.getDisplayStorageLoc'}" />
                <Input
                    value="{parts:[{path:'matConsModel>value'},{path:'matConsModel>selectedUoM'}], type:'.types.quantity'}"
                    textAlign="Left" enabled="{=!${matConsModel>backflushEnabled}}"
                    change=".MaterialComponents.onValueChange" />
                <Select enabled="{=!${matConsModel>backflushEnabled}}" width="100%" forceSelection="false"
                    change=".MaterialComponents.handleSelectChange" selectedKey="{matConsModel>selectedUoM}"
                    items="{path:'matConsModel>unitList', templateShareable:false}">
                    <core:Item key="{matConsModel>uom}" text="{matConsModel>uom} - {matConsModel>shortText}" />
                </Select>
                <DateTimePicker value="{path : 'matConsModel>postingDateTime', formatter:'.formatter.formatDateTime'}"
                    initialFocusedDateValue="{matConsModel>focusedDateTime}" valueFormat="yyyy-MM-dd HH:mm:ss"
                    formatter=".formatter.formatDateTime" change=".MaterialComponents.handleChangeDateTime"
                    enabled="{=!${matConsModel>backflushEnabled}}" />
                <Input value="{matConsModel>postedBy}" enabled="false" />
                <Input value="{matConsModel>customFieldValue}"
                    visible="{=${configuration>/customField1} ? true : false}"
                    liveChange=".MaterialComponents.onCustomFieldLiveChange" />
                <HBox>
                    <Button icon="sap-icon://sys-add" type="Transparent" press=".MaterialComponents.onPressAdd"
                        class="sapUiTinyMarginRight" tooltip="{i18n-global>common.add.btn}"
                        enabled="{ parts:['matConsModel>backflushEnabled', 'configuration>/sequence'], formatter: '.MaterialComponents.enableAddButton'}" />
                    <Button icon="sap-icon://sys-minus" type="Transparent" press=".MaterialComponents.onPressRemove"
                        tooltip="{i18n-global>common.delete.btn}" enabled="{matConsModel>removeEnabled}" />
                </HBox>
            </ColumnListItem>
        </items>
    </Table>
</core:FragmentDefinition>
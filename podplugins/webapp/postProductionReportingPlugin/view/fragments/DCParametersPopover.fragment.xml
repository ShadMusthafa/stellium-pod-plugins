<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout">
<Popover id="dcParametersPopover" showHeader="true" contentWidth="400px" resizable="true" placement="Left" title="{i18n>DCParameterPopupTitle}">
<Table id="dcParametersTable" width="100%" inset="false" backgroundDesign="Solid" mode="None" class="sapUiSizeCompact" growing="true" growingThreshold="50" growingScrollToLoad="true" items="{ path: 'ParametersData>/parameters', sorter: { path: 'sfc', descending: false, group: true }, groupHeaderFactory: '.getParameterListGroupHeader' }">
<columns>
<Column width="50%" hAlign="Begin" vAlign="Middle">
<Text text="{i18n>DCParameter_NameType.LABEL}" wrapping="false"/>
</Column>
<Column hAlign="End">
<Text text="{i18n>DCParameter_ValueUnit.LABEL}" wrapping="false"/>
</Column>
</columns>
<items>
<ColumnListItem>
<cells>
<ObjectIdentifier title="{ParametersData>measureDisplayName}" text="{ParametersData>measureType}"/>
<l:VerticalLayout>
<ObjectNumber number="{ParametersData>actual}" unit="{=${ParametersData>commercialUnitOfMeasure} ? ${ParametersData>commercialUnitOfMeasure} : ${ParametersData>unitOfMeasure}}"/>
<Label text="{=${ParametersData>disabledParameter} ? ${i18n>DCParameterDisabled.LABEL} : ${ParametersData>optionalParameter} ? ${i18n>dcParameter.optional.lbl} : ''}" class="sapUiTinyMarginTop"/>
</l:VerticalLayout>
</cells>
</ColumnListItem>
</items>
</Table>
</Popover>
</core:FragmentDefinition>
<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
<Dialog id="materialComponentsPostingsDialog" title="{i18n>materialComponentsPostingDialog.header}" class="sapUiContentPadding" contentWidth="70%" resizable="true" draggable="true">
<content>
<Table id="materialComponentsPostingsTable" autoPopinMode="true" items="{matCompPostingsModel>/details}" growing="true" growingScrollToLoad="true" growingThreshold="35" updateStarted=".MaterialComponentsPostingDialog.fetchMoreGiPostingDetails">
<columns>
<Column mergeDuplicates="true" minScreenWidth="Small" demandPopin="true">
<header>
<Text text="{i18n>process.material.col}"/>
</header>
</Column>
<Column demandPopin="true" minScreenWidth="Small" hAlign="End">
<header>
<Text text="{i18n>process.quantity.col}"/>
</header>
</Column>
<Column visible="{= ${matCompPostingsModel>/batchManaged} === 'ORDER'}" demandPopin="true" minScreenWidth="Small" hAlign="End">
<header>
<Text text="{i18n>process.batchId.col}"/>
</header>
</Column>
<Column demandPopin="true" minScreenWidth="Small" hAlign="Begin">
<header>
<Text text="{i18n>process.postedBy.col}"/>
</header>
</Column>
<Column demandPopin="true" minScreenWidth="Small" hAlign="End">
<header>
<Text text="{i18n>process.postingDate.col}"/>
</header>
</Column>
<Column demandPopin="true" hAlign="End" minScreenWidth="Tablet">
<header>
<Text text="{i18n>process.creationDate.col}"/>
</header>
</Column>
<Column hAlign="Left" demandPopin="true" minScreenWidth="Tablet">
<header>
<Text text="{i18n>process.comments.col}"/>
</header>
</Column>
<Column hAlign="Left" demandPopin="true" minScreenWidth="Tablet">
<header>
<Text text="{i18n>process.status.col}"/>
</header>
</Column>
</columns>
<ColumnListItem id="materialComponentsPostingDetailsCLItem">
<cells>
<Text text="{matCompPostingsModel>material}"/>
<Text text="{parts : ['matCompPostingsModel>quantity/value','matCompPostingsModel>quantity/unitOfMeasure/uom'],formatter:'.formatter.showFormattedValueWithUom'}" textAlign="Right"/>
<Text text="{matCompPostingsModel>batchNumber}"/>
<Text text="{matCompPostingsModel>userId}" textAlign="Left"/>
<Text text="{path : 'matCompPostingsModel>dateTime',formatter:'.formatter.formatUTCDateTimeToPlantTimeZone'}"/>
<Text text="{path : 'matCompPostingsModel>createdDateTime',formatter:'.formatter.formatUTCDateTimeToPlantTimeZone'}"/>
<HBox width="100%" alignItems="Start" justifyContent="Start">
<items>
<Text text="{matCompPostingsModel>comments}" textAlign="Begin" wrapping="true" class="sapDmeJustifiedTextAlign"/>
</items>
</HBox>
<Text text="{path : 'matCompPostingsModel>status',formatter:'.MaterialComponentsPostingDialog.formatMaterialConsumptionStatus'}"/>
</cells>
</ColumnListItem>
</Table>
</content>
<beginButton>
<Button text="{i18n>close}" press=".MaterialComponentsPostingDialog.onCloseMaterialComponentsPostingsDialog"/>
</beginButton>
</Dialog>
</core:FragmentDefinition>
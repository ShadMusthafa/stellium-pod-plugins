<mvc:View 
    xmlns:l="sap.ui.layout" 
    xmlns:mvc="sap.ui.core.mvc" 
    xmlns="sap.m" 
    controllerName="stellium.ext.podplugins.resourceListPlugin.controller.PluginView" 
    width="100%" 
    height="100%">
    <Panel id="podModelPluginPanel" width="100%" height="100%" expandable="false" expanded="true" accessibleRole="Region" backgroundDesign="Transparent">
        <content>
           <Table id="idResourceListTable"
                items="{
                    path: 'data>/lineItems',
                    sorter: { path: 'workCenter', group: true }
                }">
                <columns>
                    <Column mergeDuplicates="true"><Text text="Workcenter"/></Column>
                    <Column><Text text="Resource"/></Column>
                    <Column><Text text="Resource Type"/></Column>
                    <Column><Text text="Resource Status"/></Column>
                    <Column><Text text="Operator"/></Column>
                    <Column><Text text="Order"/></Column>
                    <Column><Text text="Component"/></Column>
                    <Column><Text text="Description"/></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{data>workCenter}"/>
                            <Text text="{data>resource}"/>
                            <HBox items="{data>resourceType}">
                                <Text text="{data>type}"/>
                            </HBox>
                            <ObjectStatus
                                text="{
                                    path: 'data>resourceStatus',
                                    formatter: '.resourceStatusTextFormatter'
                                }"
                                inverted="true"
                                icon="{
                                    path: 'data>resourceStatus',
                                    formatter: '.resourceStatusIconFormatter'
                                }"
                                state="{
                                    path: 'data>resourceStatus',
                                    formatter: '.resourceStatusStatusFormatter'
                                }" />
                            <Text text="{data>operator}"/>
                            <Text text="{data>order}"/>
                            <Text text="{data>component}"/>
                            <Text text="{data>componentDesc}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Panel>
</mvc:View>
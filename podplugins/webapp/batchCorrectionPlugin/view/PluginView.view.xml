<mvc:View 
    controllerName="stellium.ext.podplugins.batchCorrectionPlugin.controller.PluginView" 
    xmlns:mvc="sap.ui.core.mvc" 
    xmlns:form="sap.ui.layout.form"
    xmlns="sap.m" 
    width="100%" 
    height="100%">
    <!-- <Panel id="podModelPluginPanel" width="100%" height="100%" expandable="false" expanded="true" accessibleRole="Region" backgroundDesign="Transparent"> -->
    <Page showFooter="true">
        <content>
            <form:SimpleForm 
                id="idOrderHeaderForm" 
                title="Order Details" 
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="3"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="4"
                emptySpanL="4"
                emptySpanM="4"
                emptySpanS="0"
                columnsXL="1"
                columnsL="1"
                columnsM="1"
                singleContainerFullSize="false" >
                <Label text="Calculated GR Quantity"/>
                <HBox width="20rem">
                    <StepInput 
                        id="idStepInput"
                        value="{viewModel>/scaleFactor/value}"
                        min="{viewModel>/scaleFactor/min}"
                        max="{viewModel>/scaleFactor/max}"
                        step="{viewModel>/scaleFactor/stepSize}"
                        displayValuePrecision="{viewModel>/scaleFactor/precision}"
                        change="onStepInputChange" 
                        width="10rem"
                        class="sapUiTinyMarginEnd" />
                    <Label/>
                    <Button text="Check" enabled="{viewModel>/isCheckEnabled}" press=".onCalculateNewBomQty"/>
                </HBox>                
            </form:SimpleForm>
            <Table id="idBatchTable" visible="true" class="sapUiSmallMargin" popinLayout="GridLarge" 
                items="{
                    path: 'giData>/lineItems',
                    filters : [
                        { path : 'componentType', operator : 'EQ', value1 : 'N'}
                    ]
                }" >
                <headerToolbar>
                    <Toolbar width="100%">
                        <Title id="idBatchtitleText" level="H2" text="Components" />
                        <ToolbarSpacer/>
                        <!-- <Label text="{i18n>scaleFactor}" class="sapUiTinyMarginEnd"/> -->
                        <!-- <StepInput 
                            id="idStepInput"
                            value="{viewModel>/scaleFactor/value}"
                            min="{viewModel>/scaleFactor/min}"
                            max="{viewModel>/scaleFactor/max}"
                            step="{viewModel>/scaleFactor/stepSize}"
                            displayValuePrecision="{viewModel>/scaleFactor/precision}"
                            change="onStepInputChange" 
                            width="10rem"
                            class="sapUiTinyMarginEnd" /> -->
                        <Button text="Calculate Correction" press=".onCalculateBatchCorrectionBtnPress"/>
                        <Text text="" />
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column><Text text="{i18n>componentColLab}"/></Column>
                    <Column><Text text="{i18n>bomTargetColLab}"/></Column>
                    <Column><Text text="{i18n>measureColLab}"/></Column>
                    <Column><Text text="{i18n>statusColLab}"/></Column>
                    <Column><Text text="{i18n>correctionColLab}"/></Column>
                    <!-- <Column><Text text="{i18n>correctionInputColLab}"/></Column> -->
                    <Column><Text text="{i18n>issueColLab}"/></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <ObjectIdentifier 
                                title="{giData>materialId/material}" 
                                text="{giData>description}"/>
                            <ObjectNumber
                                number="{
                                    parts:[
                                        {path:'giData>totalQtyEntryUom'},
                                        {path:'giData>totalQtyBaseUom'},
                                        {path:'giData>targetQuantity'}
                                    ],
                                    formatter:'.oFormatter.getValidTargetValues'
                                }" 
                                unit="{giData>targetQuantity/unitOfMeasure/uom}"/>
                            <ObjectNumber
                                number="{
                                    parts:['giData>consumedQtyEntryUom/value','giData>consumedQtyEntryUom/unitOfMeasure/uom'],
                                    formatter: '.oFormatter.formatQtyWithDecimals'
                                }"
                                unit="{giData>consumedQtyEntryUom/unitOfMeasure/uom}"/>
                            <ObjectStatus
                                text="{giData>statusText}"
                                inverted="true"
                                icon="{
                                    path: 'giData>status',
                                    formatter: '.oFormatter.statusIconFormatter'
                                    }"
                                visible="{= ${giData>status} !== ''}"
                                state="{
                                    path:'giData>status',
                                    formatter: '.oFormatter.stateFormatter'
                                }" />
                            <ObjectNumber
                                number="{
                                    path:'giData>batchCorrectionWeightCalc/value',
                                    formatter:'oFormatter.formatQty'
                                }" 
                                unit="{giData>batchCorrectionWeight/unitOfMeasure/uom}"/>
                            <!-- <HBox alignItems="Center" >
                                <Input 
                                    value="{
                                        path: 'giData>batchCorrectionWeight/value',
                                        type: 'sap.ui.model.type.Float'
                                    }" 
                                    change=".onBatchCorrectionWtChange">
                                    <layoutData>
                                        <FlexItemData growFactor="2" />
                                    </layoutData>
                                </Input>
                                <Text text="{giData>batchCorrectionWeight/unitOfMeasure/uom}" textAlign="Center" width="2rem">
                                    <layoutData>
                                        <FlexItemData growFactor="1" />
                                    </layoutData>
                                </Text>
                            </HBox> -->
                            <ObjectNumber
                                number="{
                                    path: 'giData>issueWeight/value',
                                    formatter:'oFormatter.formatQty'
                                }"
                                unit="{giData>issueWeight/unitOfMeasure/uom}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
            <Table id="idByProductTable" 
                visible="true" 
                class="sapUiSmallMargin" 
                popinLayout="GridLarge"
                items="{
                    path:'giData>/lineItems',
                    filters : [
                        { path : 'componentType', operator : 'NE', value1 : 'N'}
                    ]}">
                <headerToolbar>
                    <Toolbar width="100%">
                        <Title id="idByProductTableTitleText" level="H2" text="By Products &amp; Co Products" />
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column><Text text="{i18n>componentColLab}"/></Column>
                    <Column><Text text="{i18n>bomTargetColLab}"/></Column>
                    <Column><Text text="{i18n>measureColLab}"/></Column>
                    <Column><Text text="{i18n>statusColLab}"/></Column>
                    <Column><Text text="{i18n>correctionColLab}"/></Column>
                    <Column><Text text="{i18n>issueColLab}"/></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <ObjectIdentifier 
                                title="{giData>materialId/material}" 
                                text="{giData>description}"/>
                            <!-- <ObjectNumber
                                number="{
                                    parts:[
                                        {path:'giData>totalQtyEntryUom'},
                                        {path:'giData>totalQtyBaseUom'},
                                        {path:'giData>targetQuantity'}
                                    ],
                                    formatter:'.oFormatter.getValidTargetValues'
                                }" 
                                unit="{giData>targetQuantity/unitOfMeasure/uom}"/> -->
                            <ObjectNumber
                                number="{giData>targetQuantity/value}" 
                                unit="{giData>targetQuantity/unitOfMeasure/uom}"/>
                            <ObjectNumber
                                number="{
                                    parts:['giData>consumedQtyEntryUom/value','giData>consumedQtyEntryUom/unitOfMeasure/uom'],
                                    formatter: '.oFormatter.formatQtyWithDecimals'
                                }"
                                unit="{giData>consumedQtyEntryUom/unitOfMeasure/uom}"/>
                            <ObjectStatus
                                text="{giData>statusText}"
                                inverted="true"
                                icon="{
                                    path: 'giData>status',
                                    formatter: '.oFormatter.statusIconFormatter'
                                    }"
                                visible="{= ${giData>status} !== ''}"
                                state="{
                                    path:'giData>status',
                                    formatter: '.oFormatter.stateFormatter'
                                }" />
                            <ObjectNumber
                                number="{
                                    path:'giData>batchCorrectionWeightCalc/value',
                                    formatter:'oFormatter.formatQty'
                                }" 
                                unit="{giData>batchCorrectionWeight/unitOfMeasure/uom}"/>
                            <ObjectNumber
                                number="{
                                    path: 'giData>issueWeight/value',
                                    formatter:'oFormatter.formatQty'
                                }"
                                unit="{giData>issueWeight/unitOfMeasure/uom}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <Button text="{i18n>approve}" type="Accept" press="onApprove"/>
                <Button text="{i18n>reject}" type="Reject" press="onReject"/>
            </Toolbar>
        </footer>
    </Page>
    <!-- </Panel> -->
</mvc:View>
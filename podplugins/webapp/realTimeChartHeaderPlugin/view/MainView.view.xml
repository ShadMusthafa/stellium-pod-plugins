<mvc:View controllerName="stellium.ext.podplugins.realTimeChartHeaderPlugin.controller.MainView" width="100%" height="100%"
    xmlns:mvc="sap.ui.core.mvc" 
    xmlns="sap.m"
    xmlns:l="sap.ui.layout">
    <Panel id="idRealTimeHeaderPluginPanel" 
        width="100%" 
        height="100%" 
        expanded="true" 
        accessibleRole="Region"
        expand="onPanelExpandPressed" 
        backgroundDesign="Solid">
        <content>
            <HBox fitContainer="true" alignItems="Stretch">
                <VBox class="sapUiNoContentPadding" width="100%">
                    <items>
                        <HBox width="100%" renderType="Bare" justifyContent="Start" class="sapUiNoContentPadding"
                            visible="{headerInformationConfig>/showInPlugin}">
                            <HBox class="sapUiNoContentPadding" alignItems="Center" justifyContent="Start"
                                renderType="Bare">
                                <!-- <Title id="expandedTitle"
                                    text="{parts : [ 'orderData>/orderSelectionType', 'orderData>/showMultipleSfcsEnabled', 'orderData>/order', 'orderData>/sfc' ], formatter: '.formatter.formatTitle'}"
                                    tooltip="{parts : [ 'orderData>/orderSelectionType', 'orderData>/showMultipleSfcsEnabled', 'orderData>/order', 'orderData>/sfc' ], formatter: '.formatter.formatTitleTooltip'}"
                                    wrapping="false" class="sapUiTinyMarginEnd sapUiTinyMarginTop" /> -->
                                <!-- <Title text="Resource: {headerData>/resource}"
                                    wrapping="false" class="sapUiTinyMarginEnd sapUiTinyMarginTop"/> -->
                            </HBox>
                        </HBox>
                        <HBox wrap="Wrap" renderType="Bare" class="sapUiNoContentPadding"
                            visible="{=(${headerInformationConfig>/panelExpanded})}">
                            <l:VerticalLayout class="sapUiSmallMarginBegin sapUiMediumMarginEnd"
                                visible="{headerInformationConfig>/orderIdFieldVisible}">
                                <Label id="expandedOrderIdLabel"
                                    text="Order:"/>
                                <ObjectStatus id="expandedOrderId" text="{headerData>/order}" />
                            </l:VerticalLayout>
                            <l:VerticalLayout class="sapUiSmallMarginBegin sapUiMediumMarginEnd"
                                visible="{headerInformationConfig>/componentIdFieldVisible}">
                                <Label id="expandedComponentIdLabel"
                                    text="Component:"
                                    tooltip="{headerInformationConfig>/orderIdFieldTooltip}" />
                                <ObjectStatus id="expandedComponentId" text="{headerData>/component}" />
                            </l:VerticalLayout>
                            <l:VerticalLayout class="sapUiSmallMarginBegin sapUiMediumMarginEnd"
                                visible="{headerInformationConfig>/operatorIdFieldVisible}">
                                <Label id="expandedOperatorIdLabel"
                                    text="Operator:"/>
                                <ObjectStatus id="expandedOperatorId" text="{headerData>/operator}" />
                            </l:VerticalLayout>
                            <l:VerticalLayout class="sapUiSmallMarginBegin sapUiMediumMarginEnd"
                                visible="{headerInformationConfig>/resourceIdFieldVisible}">
                                <Label id="expandedResourceIdLabel"
                                    text="Resource:"/>
                                <ObjectStatus id="expandedResourceId" text="{headerData>/resource}" />
                            </l:VerticalLayout>
                             <l:VerticalLayout class="sapUiSmallMarginBegin sapUiMediumMarginEnd"
                                visible="{headerInformationConfig>/passPortionVisible}">
                                <Label id="expandedPassPortionLabel"
                                    text="Pass Portion:"
                                    tooltip="{headerInformationConfig>/orderIdFieldTooltip}" />
                                <ObjectStatus id="expandedPassPortion" text="{headerData>/passPortion}" />
                            </l:VerticalLayout>
                            <l:VerticalLayout class="sapUiSmallMarginBegin sapUiMediumMarginEnd"
                                visible="{headerInformationConfig>/failPortionVisible}">
                                <Label id="expandedFailPortionLabel"
                                    text="Fail Portion:"
                                    tooltip="{headerInformationConfig>/orderIdFieldTooltip}" />
                                <ObjectStatus id="expandedFailPortion" text="{headerData>/failPortion}" />
                            </l:VerticalLayout>
                            <l:VerticalLayout class="sapUiSmallMarginBegin sapUiMediumMarginEnd"
                                visible="{headerInformationConfig>/cumulativeCountVisible}">
                                <Label id="expandedCumulativeCountLabel"
                                    text="Cumulative Count:"/>
                                <ObjectStatus id="expandedCumulativeCount" text="{headerData>/cumulativeCount}" />
                            </l:VerticalLayout>
                            <l:VerticalLayout class="sapUiSmallMarginBegin sapUiMediumMarginEnd"
                                visible="{headerInformationConfig>/consequtiveCountVisible}">
                                <Label id="expandedConsequtiveCountLabel"
                                    text="Consecutive Count:"/>
                                <ObjectStatus id="expandedConsequtiveCount" text="{headerData>/consequtiveCount}" />
                            </l:VerticalLayout>
                        </HBox>
                    </items>
                </VBox>
            </HBox>
        </content>    
    </Panel>
</mvc:View>